<?xml version="1.0" encoding="utf-8"?>
<!--
  Yatay yerleşim: yazılar solda tek sütun, kadran sağda. Dikey yerleşimle aynı
  kimlikleri kullanır, MainActivity iki durumda da aynı kodu çalıştırır.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#FF101418"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/degreeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0°"
            android:textColor="#FFFFFFFF"
            android:textSize="52sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/directionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/magnetic_north"
            android:textColor="#FF8A94A0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/infoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="6dp"
            android:text=""
            android:textColor="#FF8A94A0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/locationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="6dp"
            android:text=""
            android:textColor="#FF8A94A0"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/targetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/target_hint"
            android:textColor="#FF6C7683"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:minLines="2"
            android:text=""
            android:textColor="#FFE0A030"
            android:textSize="14sp" />
    </LinearLayout>

    <com.cem.pusula.CompassView
        android:id="@+id/compassView"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

</LinearLayout>
